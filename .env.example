# Database - PostgreSQL (get a free database from neon.tech)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API Key for Claude
ANTHROPIC_API_KEY="sk-ant-your-api-key-here"

# Shared code that must be entered to register as an instructor. Share it only
# with people who should have instructor access; anyone without it is
# restricted to a student account. Leave unset to block ALL instructor
# self-registration (create instructors via db:studio/seed instead).
INSTRUCTOR_REGISTRATION_CODE="change-me"
