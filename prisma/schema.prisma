generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  clients     Client[]     // Instructor's created clients
  assignments Assignment[] // Student's assigned clients
}

enum Role {
  INSTRUCTOR
  STUDENT
}

model Client {
  id           String @id @default(cuid())
  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  // Basic Info (visible to students)
  name              String
  presentingConcern String // Brief description shown to students

  // Full Profile (instructor only, used for AI prompt)
  age                Int?
  pronouns           String?
  genderIdentity     String?
  raceEthnicity      String?
  sexualOrientation  String?
  disability         String?
  religion           String?
  socioeconomic      String?
  immigrationStatus  String?
  indigenousIdentity String?
  veteranStatus      String?
  nationality        String?

  // Clinical Details
  fullBackstory      String // Detailed background story
  personality        String? // Personality traits
  communicationStyle String? // How they communicate
  resistanceLevel    String? // low, medium, high
  therapeuticGoals   String? // What they hope to achieve

  // Diagnostic intake track (separate from therapy track)
  mode                  ClientMode @default(THERAPY)
  targetDiagnosis       String? // Hidden DSM diagnosis the client is designed to present with
  dsmCategory           String? // e.g. "Depressive Disorders", "Bipolar and Related Disorders"
  weekNumber            Int? // 1-5, for curriculum progression
  diagnosticCriteriaMap Json? // [{ criterion: string, clientStatement: string }]

  // When true, any instructor can see and assign this client (only owner can edit/delete).
  isShared Boolean @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
}

enum ClientMode {
  THERAPY
  DIAGNOSIS
}

model Assignment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  sessions Session[]

  @@unique([studentId, clientId])
}

model Session {
  id            String        @id @default(cuid())
  assignmentId  String
  assignment    Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sessionNumber Int // 1, 2, or 3 (therapy); 1 (diagnosis)
  status        SessionStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  duration      Int? // Duration in seconds
  studentGuess  String? // Student's diagnostic guess before the reveal (diagnosis mode)

  messages Message[]

  @@unique([assignmentId, sessionNumber])
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "student" or "client"
  content   String
  timestamp DateTime @default(now())
}
